<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F6FC" android:fitsSystemWindows="true" android:gravity="center" android:orientation="vertical" android:padding="16dp" tools:context="com.team.tetris.ui.TetrisMenuActivity">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tetris_img_logo" android:contentDescription="@string/tetris_app_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tetris_app_name" android:textSize="40sp" android:textStyle="bold" android:gravity="center" android:textColor="#132447" />
            <LinearLayout android:layout_width="300dp" android:layout_height="wrap_content" android:layout_marginTop="60dp" android:gravity="center" android:orientation="vertical">
                <Button android:id="@+id/tetris_btn_play" android:contentDescription="@string/tetris_play_label" android:layout_width="200dp" android:layout_height="56dp" android:text="@string/tetris_play_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
                <Button android:id="@+id/tetris_btn_tutorial" android:contentDescription="@string/tetris_tutorial_label" android:layout_width="200dp" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/tetris_tutorial_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/tetris_btn_sound" android:contentDescription="@string/tetris_sound_label" android:layout_width="88dp" android:layout_height="56dp" android:layout_gravity="top|end" android:layout_marginTop="16dp" android:layout_marginEnd="16dp" android:text="@string/tetris_sound_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
        <FrameLayout android:id="@+id/tetris_sound_menu_layer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="true" android:focusable="true">
            <TextView android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tetris_card" android:gravity="top|center_horizontal" android:paddingTop="16dp" android:textSize="20sp" android:textColor="#132447" android:text="@string/tetris_sound_label" />
            <LinearLayout android:layout_width="260dp" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:paddingTop="40dp">
                <SeekBar android:id="@+id/tetris_seek_bar_bgm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="32dp" android:max="100" android:progress="100" android:progressTint="#FFFFFF" android:thumbTint="#FFFFFF" />
                <Button android:id="@+id/tetris_btn_close_sound_menu" android:contentDescription="@string/tetris_close_label" android:layout_width="60dp" android:layout_height="56dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:text="@string/tetris_close_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/tetris_tutorial_layer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="true" android:focusable="true">
            <TextView android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tetris_card" android:gravity="top|center_horizontal" android:paddingTop="16dp" android:textSize="20sp" android:textColor="#132447" android:text="@string/tetris_tutorial_label" />
            <LinearLayout android:layout_width="260dp" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:paddingTop="50dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" android:text="@string/tetris_move_hint" android:textColor="#132447" android:textSize="10sp" android:lineSpacingExtra="6dp" android:textAlignment="center" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" android:text="@string/tetris_rotate_hint" android:textColor="#132447" android:textSize="10sp" android:textAlignment="center" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" android:text="@string/tetris_drop_hint" android:textColor="#132447" android:textSize="10sp" android:lineSpacingExtra="6dp" android:textAlignment="center" android:fontFamily="sans-serif-medium" />
                <Button android:id="@+id/tetris_btn_close_tutorial" android:contentDescription="@string/tetris_close_label" android:layout_width="60dp" android:layout_height="56dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:text="@string/tetris_close_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>