<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F6FC" android:fitsSystemWindows="true" android:orientation="vertical" android:padding="16dp" tools:context="com.team.tetris.ui.TetrisActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="16dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <FrameLayout android:id="@+id/tetris_next_piece_container" android:layout_width="80dp" android:layout_height="80dp" android:background="@drawable/tetris_card" android:padding="4dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/tetris_next" android:textSize="12sp" android:textColor="#132447" />
            <com.team.tetris.ui.NextPieceView android:id="@+id/tetris_next_piece_view" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="18dp" />
        </FrameLayout>
        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/tetris_pause" android:contentDescription="@string/tetris_pause_label" android:layout_width="80dp" android:layout_height="56dp" android:text="@string/tetris_pause_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <FrameLayout android:layout_width="80dp" android:layout_height="80dp" android:background="@drawable/tetris_card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/tetris_score_label" android:textSize="12sp" android:textColor="#132447" />
            <TextView android:id="@+id/tetris_tv_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="10dp" android:text="0" android:textColor="#132447" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
        </FrameLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="16dp">
        <FrameLayout android:id="@+id/tetris_game_container" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/tetris_card" android:padding="8dp">
            <com.team.tetris.ui.TetrisView android:id="@+id/tetris_game_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" />
        </FrameLayout>
        <FrameLayout android:id="@+id/tetris_img_paused_menu" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="true" android:focusable="true">
            <TextView android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tetris_card" android:gravity="top|center_horizontal" android:paddingTop="16dp" android:textSize="20sp" android:textColor="#132447" android:text="@string/tetris_pause_label" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                <Button android:id="@+id/tetris_btn_resume" android:contentDescription="@string/tetris_resume_label" android:layout_width="100dp" android:layout_height="56dp" android:layout_marginEnd="0dp" android:text="@string/tetris_resume_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
                <Button android:id="@+id/tetris_btn_sound" android:contentDescription="@string/tetris_sound_label" android:layout_width="100dp" android:layout_height="56dp" android:text="@string/tetris_sound_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
                <Button android:id="@+id/tetris_btn_quit" android:contentDescription="@string/tetris_save_exit_label" android:layout_width="100dp" android:layout_height="56dp" android:text="@string/tetris_save_exit_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" android:layout_marginEnd="0dp" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/tetris_sound_menu_layer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="true" android:focusable="true">
            <TextView android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tetris_card" android:gravity="top|center_horizontal" android:paddingTop="16dp" android:textSize="20sp" android:textColor="#132447" android:text="@string/tetris_sound_label" />
            <LinearLayout android:layout_width="260dp" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:layout_marginTop="32dp" android:paddingTop="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" android:text="@string/tetris_background_music" android:textColor="#132447" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
                <SeekBar android:id="@+id/tetris_seek_bar_bgm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:max="100" android:progress="100" android:progressTint="#FFFFFF" android:thumbTint="#FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" android:text="@string/tetris_sfx" android:textColor="#132447" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
                <SeekBar android:id="@+id/tetris_seek_bar_sfx" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:max="100" android:progress="100" android:progressTint="#FFFFFF" android:thumbTint="#FFFFFF" />
                <Button android:id="@+id/tetris_btn_close_sound_menu" android:contentDescription="@string/tetris_close_label" android:layout_width="60dp" android:layout_height="56dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:text="@string/tetris_close_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/tetris_game_over_layer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clickable="true" android:focusable="true">
            <TextView android:contentDescription="@null" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tetris_card" android:gravity="top|center_horizontal" android:paddingTop="16dp" android:textSize="20sp" android:textColor="#132447" android:text="@string/tetris_finished" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:paddingTop="30dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/tetris_your_score" android:textColor="#132447" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tetris_tv_final_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="32dp" android:text="0" android:textColor="#132447" android:textSize="24sp" android:fontFamily="sans-serif-medium" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <Button android:id="@+id/tetris_btn_replay" android:contentDescription="@string/tetris_replay_label" android:layout_width="100dp" android:layout_height="56dp" android:layout_marginEnd="0dp" android:text="@string/tetris_replay_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" />
                    <Button android:id="@+id/tetris_btn_quit_game_over" android:contentDescription="@string/tetris_exit_label" android:layout_width="100dp" android:layout_height="56dp" android:text="@string/tetris_exit_label" android:backgroundTint="#175AE8" android:textColor="#FFFFFF" android:textAllCaps="false" android:paddingLeft="4dp" android:paddingRight="4dp" android:layout_marginEnd="0dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>