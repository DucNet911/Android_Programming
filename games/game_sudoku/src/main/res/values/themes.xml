<resources>
  <style name="Theme.Sudoku.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    <item name="colorPrimary">@color/primary</item>
    <item name="colorPrimaryVariant">@color/primary_dark</item>
    <item name="colorOnPrimary">@color/surface</item>
    <item name="colorSecondary">@color/hint</item>
    <item name="android:windowBackground">@color/background</item>
    <item name="colorSurface">@color/surface</item>
    <item name="colorOnSurface">@color/ink</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:statusBarColor">@color/background</item>
    <item name="android:navigationBarColor">@color/primary_dark</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:colorAccent">@color/primary</item>
    <item name="materialButtonStyle">@style/Widget.Sudoku.Button</item>
  </style>
  <style name="Widget.Sudoku.Button" parent="Widget.MaterialComponents.Button">
    <item name="cornerRadius">18dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:textSize">15sp</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:elevation">0dp</item>
    <item name="android:translationZ">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="Text.Sudoku.Title" parent="">
    <item name="android:textColor">@color/ink</item>
    <item name="android:textSize">26sp</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="Text.Sudoku.Body" parent="">
    <item name="android:textColor">@color/muted</item>
    <item name="android:textSize">14sp</item>
    <item name="android:lineSpacingExtra">4dp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="Widget.Sudoku.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
    <item name="cornerRadius">18dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">52dp</item>
    <item name="strokeColor">@color/grid</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:elevation">0dp</item>
    <item name="android:translationZ">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="Widget.Sudoku.Icon" parent="Widget.Sudoku.Button">
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:padding">12dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="iconPadding">0dp</item>
    <item name="iconSize">24dp</item>
    <item name="iconTint">@color/ink</item>
    <item name="backgroundTint">@color/surface</item>
    <item name="cornerRadius">16dp</item>
  </style>
  <style name="Widget.Sudoku.Tile" parent="Widget.Sudoku.Button">
    <item name="cornerRadius">24dp</item>
    <item name="iconGravity">textTop</item>
    <item name="iconSize">28dp</item>
    <item name="iconPadding">10dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:textSize">14sp</item>
    <item name="elevation">0dp</item>
  </style>
  <style name="Widget.Sudoku.Tool" parent="Widget.MaterialComponents.Button.TextButton">
    <item name="cornerRadius">18dp</item>
    <item name="backgroundTint">@color/related</item>
    <item name="iconTint">@color/primary</item>
    <item name="iconGravity">textTop</item>
    <item name="iconSize">24dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">10sp</item>
    <item name="android:paddingLeft">0dp</item>
    <item name="android:paddingRight">0dp</item>
    <item name="android:insetLeft">0dp</item>
    <item name="android:insetRight">0dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:elevation">0dp</item>
    <item name="android:translationZ">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="Theme.Sudoku" parent="Theme.Sudoku.Base" />
  <style name="Widget.Sudoku.ModeChoice" parent="Widget.Sudoku.Outline">
    <item name="android:minWidth">0dp</item>
    <item name="android:textSize">13sp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:paddingLeft">8dp</item>
    <item name="android:paddingRight">8dp</item>
    <item name="android:textColor">@color/mode_choice_text</item>
    <item name="backgroundTint">@color/mode_choice_background</item>
    <item name="iconTint">@color/mode_choice_text</item>
    <item name="iconSize">20dp</item>
    <item name="iconPadding">8dp</item>
    <item name="iconGravity">textStart</item>
    <item name="strokeWidth">0dp</item>
    <item name="cornerRadius">18dp</item>
  </style>
  <style name="Text.Sudoku.Nav" parent="TextAppearance.MaterialComponents.Caption">
    <item name="android:textSize">11sp</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="Shape.Sudoku.Avatar" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">50%</item>
  </style>
  <style name="Widget.Sudoku.Level" parent="Widget.Sudoku.Button">
    <item name="cornerRadius">14dp</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">0dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:paddingLeft">2dp</item>
    <item name="android:paddingRight">2dp</item>
    <item name="android:textSize">10sp</item>
    <item name="backgroundTint">@color/related</item>
    <item name="android:textColor">@color/muted</item>
  </style>
  <style name="Widget.Sudoku.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
    <item name="android:elevation">0dp</item>
    <item name="android:translationZ">0dp</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <style name="BomberTheme.Base" parent="@android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:colorAccent">#52DBCB</item>
    <item name="android:statusBarColor">#102238</item>
    <item name="android:navigationBarColor">#102238</item>
    <item name="android:windowBackground">#102238</item>
  </style>
  <style name="BomberTheme" parent="BomberTheme.Base" />
  <style name="ColorTrailTheme.Base" parent="@android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:statusBarColor">#EAF7F2</item>
    <item name="android:navigationBarColor">#EAF7F2</item>
    <item name="android:colorAccent">#146B5F</item>
    <item name="android:windowBackground">#EAF7F2</item>
  </style>
  <style name="ColorTrailTheme" parent="ColorTrailTheme.Base" />
  <color name="color_trail_background">#EAF7F2</color>
  <color name="color_trail_ink">#102D28</color>
  <color name="color_trail_accent">#146B5F</color>
</resources>
