<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/color_trail_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/color_trail_background">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="22dp">
        <Button android:id="@+id/color_trail_exit_button" style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/color_trail_exit" android:textAllCaps="false" android:textColor="@color/color_trail_accent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/color_trail_title" android:textSize="34sp" android:textStyle="bold"
            android:textColor="@color/color_trail_ink" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/color_trail_rules"
            android:textSize="15sp" android:textColor="@color/color_trail_ink" />
        <TextView android:id="@+id/color_trail_stats" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:padding="14dp" android:textSize="17sp" android:textStyle="bold"
            android:textColor="@android:color/white" android:background="@drawable/color_trail_stats_background" />
        <LinearLayout android:id="@+id/color_trail_board" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/color_trail_feedback" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="55dp" android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite" android:textSize="15sp" android:textColor="@color/color_trail_ink" />
        <Button android:id="@+id/color_trail_hint_button" android:layout_width="match_parent"
            android:layout_height="56dp" android:textAllCaps="false" android:textSize="16sp"
            android:text="@string/color_trail_hint" android:textColor="@android:color/white"
            android:background="@drawable/color_trail_stats_background" />
    </LinearLayout>
</ScrollView>
