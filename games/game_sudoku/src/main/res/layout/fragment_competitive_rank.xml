<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false" android:paddingHorizontal="20dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/rankBack" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back"
                android:contentDescription="Về Trang chủ" app:tint="@color/ink" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="Rank 1v1"
                android:textAppearance="@style/Text.Sudoku.Title" android:accessibilityHeading="true" />
        </LinearLayout>

        <FrameLayout android:id="@+id/rankSummary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:background="@drawable/bg_rank_hero">
            <com.puzzlehub.sudoku.ui.widgets.RankSpotlightView
                android:id="@+id/rankDetailSpotlight" android:layout_width="match_parent"
                android:layout_height="match_parent" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageButton android:id="@+id/rankBadge" android:layout_width="115dp"
                        android:layout_height="115dp" android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Chạm huy hiệu để vào sảnh" android:scaleType="fitCenter" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Bậc hiện tại" android:textColor="#CDDEFF" android:textSize="12sp" />
                        <TextView android:id="@+id/currentRank" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp"
                            android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
                        <TextView android:id="@+id/currentRankPoints" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="3dp"
                            android:textColor="#B6E7FF" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <ProgressBar android:id="@+id/rankProgress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="10dp"
                    android:layout_marginTop="9dp" android:progressTint="#86DFFF"
                    android:progressBackgroundTint="#5684AE" android:importantForAccessibility="no" />
                <TextView android:id="@+id/rankProgressLabel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:textColor="#DDE9FF" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/openRankLobby"
                    style="@style/Widget.Sudoku.TextButton" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="6dp"
                    android:text="Chạm huy hiệu để vào sảnh  ›" android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView android:id="@+id/rankStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textAppearance="@style/Text.Sudoku.Body" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rankRefresh"
            style="@style/Widget.Sudoku.TextButton" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Làm mới" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rankSignIn"
            style="@style/Widget.Sudoku.Outline" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Mở Cá nhân để đăng nhập" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
