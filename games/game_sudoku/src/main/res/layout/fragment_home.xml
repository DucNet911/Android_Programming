<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="620dp" android:clipChildren="false" android:clipToPadding="false" android:paddingHorizontal="20dp" android:paddingVertical="14dp">
    <com.puzzlehub.sudoku.ui.widgets.FrostedGlassLayout android:id="@+id/brand" android:layout_width="0dp" android:layout_height="64dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/greeting" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintVertical_chainStyle="packed" app:layout_constraintVertical_bias="0">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_sudoku" android:importantForAccessibility="no" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:id="@+id/homeGameTitle" android:text="SUDOKU" android:textSize="21sp" android:letterSpacing="0.02" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="@color/ink" />
            <com.puzzlehub.sudoku.ui.widgets.StreakBadgeView android:id="@+id/dailyFlame" android:layout_width="44dp" android:layout_height="32dp" android:layout_marginEnd="8dp" />
            <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:padding="3dp" android:background="@drawable/bg_avatar_ring">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/homeAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/avatar_cat" android:contentDescription="Mở Cá nhân" android:clickable="true" android:focusable="true" app:shapeAppearanceOverlay="@style/Shape.Sudoku.Avatar" app:strokeColor="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </com.puzzlehub.sudoku.ui.widgets.FrostedGlassLayout>
    <TextView android:id="@+id/greeting" android:layout_width="0dp" android:layout_height="28dp" android:layout_marginTop="14dp" android:text="Chơi một ván nhé?" android:textColor="@color/ink" android:textSize="21sp" android:fontFamily="sans-serif" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/brand" app:layout_constraintBottom_toTopOf="@id/hero" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/hero" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_home_hero" app:layout_constraintTop_toBottomOf="@id/greeting" app:layout_constraintBottom_toTopOf="@id/continueGame" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHeight_min="210dp" app:layout_constraintHeight_max="240dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/homeModeBadge" android:text="4 MỨC ĐỘ · 3 LỖI" android:textColor="@color/white" android:textSize="10sp" android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="0.04" android:background="@drawable/bg_badge" android:paddingHorizontal="12dp" android:paddingVertical="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Vào guồng\nPhá đảo" android:textSize="29sp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="@color/white" android:lineSpacingExtra="2dp" />
            <ImageView android:layout_width="90dp" android:layout_height="108dp" android:layout_marginStart="6dp" android:rotation="7" android:src="@drawable/home_board" android:importantForAccessibility="no" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/newGame" android:layout_width="match_parent" android:layout_height="50dp" android:text="Chơi ngay" android:textSize="16sp" android:textColor="@color/hero_start" app:backgroundTint="@color/white" app:cornerRadius="17dp" app:icon="@drawable/ic_arrow" app:iconTint="@color/hero_start" app:iconGravity="textEnd" app:iconPadding="12dp" android:insetTop="0dp" android:insetBottom="0dp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/continueGame" style="@style/Widget.Sudoku.Outline" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:text="Tiếp tục ván đang chơi" android:textSize="12sp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:backgroundTint="@color/surface" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/hero" app:layout_constraintBottom_toTopOf="@id/competitiveRank" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <FrameLayout
        android:id="@+id/competitiveRank" android:layout_width="0dp" android:layout_height="92dp"
        android:layout_marginTop="22dp" android:clipChildren="false" android:clipToPadding="false"
        android:clickable="true" android:focusable="true"
        android:contentDescription="Rank 1v1"
        app:layout_constraintTop_toBottomOf="@id/continueGame"
        app:layout_constraintBottom_toTopOf="@id/shortcuts"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.puzzlehub.sudoku.ui.widgets.RankSpotlightView android:id="@+id/rankSpotlight"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <com.puzzlehub.sudoku.ui.widgets.RankFlameView android:id="@+id/rankFlames"
            android:layout_width="match_parent" android:layout_height="142dp"
            android:layout_gravity="center" android:layout_marginHorizontal="-9dp"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingHorizontal="13dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/homeRankBadge" android:layout_width="72dp"
                android:layout_height="72dp" android:importantForAccessibility="no" />
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:id="@+id/homeRankTitle" android:text="Rank 1v1" android:textColor="@android:color/white"
                android:textSize="23sp" android:textStyle="bold" android:importantForAccessibility="no" />
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_arrow" android:importantForAccessibility="no" app:tint="@android:color/white" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/shortcuts" android:layout_width="0dp" android:layout_height="96dp" android:layout_marginTop="18dp" android:orientation="horizontal" app:layout_constraintTop_toBottomOf="@id/competitiveRank" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.puzzlehub.sudoku.ui.widgets.FrostedGlassLayout android:id="@+id/statistics" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true" android:contentDescription="Bảng xếp hạng">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="top|end" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:src="@drawable/art_statistics" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_marginStart="14dp" android:layout_marginBottom="14dp" android:text="Bảng xếp hạng" android:textSize="15sp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="@color/lavender_ink" />
            </FrameLayout>
        </com.puzzlehub.sudoku.ui.widgets.FrostedGlassLayout>
        <com.puzzlehub.sudoku.ui.widgets.FrostedGlassLayout android:id="@+id/history" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:clickable="true" android:focusable="true" android:contentDescription="Lịch sử">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="top|end" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:src="@drawable/art_history" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_marginStart="14dp" android:layout_marginBottom="14dp" android:text="Lịch sử" android:textSize="15sp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="@color/peach_ink" />
            </FrameLayout>
        </com.puzzlehub.sudoku.ui.widgets.FrostedGlassLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
