<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView android:id="@+id/lobbyScroll" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageButton android:id="@+id/lobbyBack" android:layout_width="48dp"
                    android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back" android:contentDescription="Về Rank 1v1" app:tint="@color/ink" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:text="Sảnh Trận chiến" android:accessibilityHeading="true"
                    android:textAppearance="@style/Text.Sudoku.Title" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:background="@drawable/bg_rank_hero"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/lobbyRankName"
                        style="@style/Widget.Sudoku.TextButton" android:layout_width="match_parent"
                        android:layout_height="48dp" android:minWidth="0dp" android:paddingStart="0dp"
                        android:ellipsize="end" android:maxLines="1" android:gravity="start|center_vertical"
                        android:text="Dũng sĩ" android:textColor="@color/white" android:textSize="22sp" />
                    <TextView android:id="@+id/lobbyRankPoints" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="5dp"
                        android:textColor="#C5DFFF" android:textSize="13sp" />
                </LinearLayout>
                <ImageView android:id="@+id/lobbyRankBadge" android:layout_width="74dp"
                    android:layout_height="74dp" android:layout_marginStart="5dp" android:importantForAccessibility="no" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView android:id="@+id/createPanel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" app:cardBackgroundColor="@color/room_panel_start"
                app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/room_panel_stroke" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp"
                    android:background="@drawable/bg_room_create">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Tạo phòng" android:textColor="@color/room_option_text"
                        android:textSize="20sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/mode"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="9dp" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/competitive"
                            style="@style/Widget.Sudoku.ModeChoice" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="48dp" android:textSize="12sp" android:textColor="@color/room_option_text"
                            app:backgroundTint="@color/room_option_tint" app:strokeColor="@color/room_panel_stroke" android:text="Đối kháng 1v1" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/cooperative"
                            style="@style/Widget.Sudoku.ModeChoice" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="48dp" android:textSize="12sp" android:textColor="@color/room_option_text"
                            app:backgroundTint="@color/room_option_tint" app:strokeColor="@color/room_panel_stroke" android:text="Cùng giải" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="Độ khó" android:textColor="@color/muted" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/difficulty"
                            style="@style/Widget.Sudoku.Outline" android:layout_width="wrap_content"
                            android:layout_height="48dp" android:insetTop="0dp" android:insetBottom="0dp"
                            android:text="Mới chơi" android:textSize="13sp" android:textColor="@color/room_option_text"
                            app:strokeColor="@color/room_panel_stroke"
                            app:icon="@drawable/ic_level_beginner" app:iconTint="@null" app:iconSize="18dp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/createRoom"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="11dp" android:insetTop="0dp" android:insetBottom="0dp"
                        android:text="Tạo phòng" android:textColor="@color/white"
                        app:backgroundTint="@color/room_action_tint" app:iconTint="@color/white" app:icon="@drawable/ic_arrow" app:iconGravity="textEnd" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton android:id="@+id/openJoinRoom"
                style="@style/Widget.Sudoku.TextButton" android:layout_width="match_parent"
                android:layout_height="54dp" android:layout_marginTop="6dp"
                android:text="Đã có phòng? Nhập mã  ›" android:textSize="14sp" />
            <ProgressBar android:id="@+id/loading" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_gravity="center" android:layout_marginTop="8dp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout android:id="@+id/waitingOverlay" android:layout_width="match_parent"
        android:layout_height="match_parent" android:clickable="true" android:focusable="true"
        android:paddingHorizontal="20dp" android:visibility="gone" />
</FrameLayout>
