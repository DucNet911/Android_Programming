<resources>
    <style name="Theme.Arcade" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/platform_background</item>
        <item name="android:colorBackground">@color/platform_background</item>
        <item name="android:textColorPrimary">@color/platform_text</item>
        <item name="android:textColorSecondary">@color/platform_muted</item>
        <item name="colorAccent">@color/platform_accent</item>
        <item name="colorPrimary">@color/platform_surface</item>
        <item name="colorPrimaryDark">@color/platform_background</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <item name="android:navigationBarColor">@color/platform_background</item>
    </style>
    <style name="PlatformText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/platform_text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="PlatformMuted" parent="PlatformText">
        <item name="android:textColor">@color/platform_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="PlatformButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/platform_background</item>
        <item name="backgroundTint">@color/platform_accent</item>
    </style>
</resources>
