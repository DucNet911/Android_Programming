<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/platform_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="20dp" android:clipToPadding="false" android:background="@color/platform_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <Button android:id="@+id/history_back" style="@style/PlatformButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back"/>
    <TextView style="@style/PlatformText" android:text="@string/history_title" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
    <TextView style="@style/PlatformMuted" android:text="@string/history_subtitle" android:layout_marginTop="8dp"/>
    <Spinner android:id="@+id/history_filter" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:backgroundTint="@color/platform_accent"/>
    <TextView android:id="@+id/history_records" style="@style/PlatformMuted" android:layout_width="match_parent" android:padding="12dp" android:background="@drawable/platform_card"/>
    <TextView android:id="@+id/history_count" style="@style/PlatformMuted" android:layout_marginVertical="12dp"/>
    <TextView android:id="@+id/history_empty" style="@style/PlatformMuted" android:text="@string/empty_history" android:layout_marginTop="24dp" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
