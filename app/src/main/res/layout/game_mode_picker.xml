<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="#F3F6FC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/mode_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="20dp"
            android:textSize="28sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:background="@drawable/mode_header" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:layout_marginBottom="8dp"
            android:text="@string/choose_difficulty" android:textColor="#132447" android:textSize="18sp" />
        <LinearLayout android:id="@+id/mode_choices" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
